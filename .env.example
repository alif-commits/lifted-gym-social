# --- Required ---
# Neon Postgres pooled connection string
DATABASE_URL=
# Public base URL of the app (used in emails, OG tags). No trailing slash.
APP_URL=http://localhost:3000

# --- Media storage ---
# Vercel Blob read/write token (private store). If empty, uploads fall back to ./.data/uploads (development only).
BLOB_READ_WRITE_TOKEN=

# --- AI food scanner ---
# Vercel AI Gateway key (not needed on Vercel when OIDC is available). If empty, a deterministic mock provider is used.
AI_GATEWAY_API_KEY=
# Vision model (AI Gateway "provider/model" id)
FOOD_SCAN_MODEL=google/gemini-3.8-flash

# --- Email (optional) ---
# If empty, verification/reset links are printed to the server log (development only).
# Resend test sender (no domain needed) can only deliver to the Resend account email.
RESEND_API_KEY=
EMAIL_FROM="LIFTED <no-reply@lifted.app>"

# --- Cron (optional) ---
# Shared secret for /api/cron/* (Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Admin (optional) ---
# This email is granted admin on register, and by `npm run db:seed` if the account already exists.
ADMIN_BOOTSTRAP_EMAIL=

# --- Google SSO (optional) ---
# If empty, the Google button is hidden and email/password login is unchanged.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Strava import (optional) ---
# One-way import. Redirect URI: {APP_URL}/api/v1/integrations/strava/callback
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_SECRET=
