# --- Required ---
# Neon Postgres pooled connection string
DATABASE_URL=
# Public base URL of the app (used in emails, OG tags). No trailing slash.
APP_URL=http://localhost:3000

# --- Media storage ---
# Vercel Blob read/write token (private store). If empty, uploads fall back to ./.data/uploads (development only).
BLOB_READ_WRITE_TOKEN=

# --- AI food scanner ---
# Vercel AI Gateway key (not needed on Vercel when OIDC is available). If empty, a deterministic mock provider is used.
AI_GATEWAY_API_KEY=
# Vision model (AI Gateway "provider/model" id)
FOOD_SCAN_MODEL=google/gemini-3.8-flash

# --- Email (optional) ---
# If empty, verification/reset links are printed to the server log (development only).
RESEND_API_KEY=
EMAIL_FROM="LIFTED <no-reply@example.com>"

# --- Cron (optional) ---
# Shared secret for /api/cron/* (Vercel sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
